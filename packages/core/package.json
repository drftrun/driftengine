{
  "name": "@driftengine/core",
  "version": "3.62.0",
  "description": "DriftEngine reusable browser 3D runtime",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "scripts",
    "CHANGELOG.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@driftengine/drft": "3.62.0",
    "@driftengine/physics": "3.62.0",
    "gl-matrix": "^3.4.3"
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "webgl",
    "webgpu",
    "typescript",
    "renderer",
    "webgl2",
    "scene-graph",
    "game-engine",
    "game-loop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/core"
  }
}
