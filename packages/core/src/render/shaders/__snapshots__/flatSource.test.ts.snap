  vEmissiveColor = aEmissiveColor;
  vRoughness = aRoughness;
  vGrain = aGrain;
  vRelief = aRelief;
  vTangent = aTangent;
  vSkyDirect = aChannel.y;
  vAlpha = aChannel.z;
  vThickness = aChannel.w;
  vHasTangents = uHasTangents;
  gl_Position = uViewProj * world;
}
