out vec3 vNormal;
out vec3 vColor;
out vec3 vWorldPos;
out float vEmissive;
out float vSpecular;
out vec4 vLightPos;
out vec2 vUv;
out vec3 vEmissiveColor;
out float vRoughness;
out float vGrain;
out float vRelief;
