{
  "name": "@driftengine/tools",
  "version": "4.1.2",
  "description": "The editor panels a shipped game can carry, and the command stack that makes their edits undoable",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@driftengine/core": "4.1.2",
    "@driftengine/editor": "4.1.2",
    "@driftengine/network": "4.1.2",
    "@driftengine/texture": "4.1.2",
    "@driftengine/ui2d": "4.1.2"
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "webgl",
    "webgpu",
    "typescript",
    "editor",
    "tools",
    "debugging"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/tools"
  }
}
