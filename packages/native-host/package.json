{
  "name": "@driftengine/native-host",
  "version": "4.1.5",
  "description": "The engine on a native window and a native WebGPU device, with no browser between them",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "licenses",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@jsquash/jpeg": "1.6.0",
    "ogg-opus-decoder": "1.7.5"
  },
  "optionalDependencies": {
    "@kmamal/gpu": "0.2.0",
    "@kmamal/sdl": "0.11.13",
    "node-web-audio-api": "2.2.0"
  },
  "devDependencies": {
    "@driftengine/audio": "4.1.5"
  },
  "peerDependencies": {
    "@driftengine/core": "4.1.5",
    "@driftengine/package": "4.1.5",
    "@driftengine/texture": "4.1.5",
    "@driftengine/ui2d": "4.1.5"
  },
  "peerDependenciesMeta": {
    "@driftengine/texture": {
      "optional": true
    },
    "@driftengine/ui2d": {
      "optional": true
    }
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/native-host"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "webgpu",
    "typescript",
    "native",
    "desktop",
    "dawn",
    "sdl"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/native-host"
  }
}
