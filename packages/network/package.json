{
  "name": "@driftengine/network",
  "version": "4.1.2",
  "description": "A transport seam, rewind and replay, lockstep and an authoritative host, on the fixed-step loop",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@driftengine/entities": "4.1.2"
  },
  "devDependencies": {
    "@driftengine/core": "4.1.2"
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/network"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "webgl",
    "webgpu",
    "typescript",
    "netcode",
    "rollback",
    "lockstep",
    "prediction",
    "multiplayer"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/network"
  }
}
