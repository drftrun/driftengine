{
  "name": "@driftengine/script",
  "version": "4.2.1",
  "description": "The drift/* capability bindings: what this engine provides to DriftScript, and the only place the two are coupled",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capabilities.json": "./capabilities.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "capabilities.json",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "dependencies": {
    "driftscript": "1.13.0"
  },
  "peerDependencies": {
    "@driftengine/ai": "4.2.1",
    "@driftengine/animation": "4.2.1",
    "@driftengine/audio": "4.2.1",
    "@driftengine/chemistry": "4.2.1",
    "@driftengine/core": "4.2.1",
    "@driftengine/editor": "4.2.1",
    "@driftengine/entities": "4.2.1",
    "@driftengine/network": "4.2.1",
    "@driftengine/terrain": "4.2.1",
    "@driftengine/ui2d": "4.2.1",
    "@driftengine/xr": "4.2.1"
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/script"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "webgl",
    "webgpu",
    "typescript",
    "scripting",
    "driftscript",
    "bindings"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/script"
  }
}
