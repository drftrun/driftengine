{
  "name": "@driftengine/package",
  "version": "4.1.3",
  "description": "Builds an installable application from a game built on the engine",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bridge": {
      "drift-source": "./src/preload/bridge.ts",
      "types": "./dist/preload/bridge.d.ts",
      "default": "./dist/preload/bridge.js"
    },
    "./store": {
      "drift-source": "./src/main/storeFile.ts",
      "types": "./dist/main/storeFile.d.ts",
      "default": "./dist/main/storeFile.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "bin",
    "android",
    "ios",
    "assets",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "bin": {
    "drift-package": "bin/drift-package.mjs"
  },
  "peerDependencies": {
    "@driftengine/core": "4.1.3",
    "steamworks.js": ">=0.4.0"
  },
  "dependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.12"
  },
  "peerDependenciesMeta": {
    "steamworks.js": {
      "optional": true
    }
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/package"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "webgl",
    "webgpu",
    "typescript",
    "electron",
    "android",
    "packaging",
    "desktop",
    "installer"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/package"
  }
}
