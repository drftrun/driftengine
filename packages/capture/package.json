{
  "name": "@driftengine/capture",
  "version": "4.3.0",
  "description": "A video to a playable scene, on the player's device: the models it runs and the stages that use them",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "drift-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "!src/**/__snapshots__",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@driftengine/core": "4.3.0",
    "@driftengine/drft": "4.3.0",
    "@driftengine/nav": "4.3.0",
    "@driftengine/physics": "4.3.0",
    "@driftengine/splats": "4.3.0",
    "@driftengine/texture": "4.3.0"
  },
  "author": "Drift Technologies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftengine.git",
    "directory": "packages/capture"
  },
  "homepage": "https://github.com/drftrun/driftengine#readme",
  "bugs": "https://github.com/drftrun/driftengine/issues",
  "keywords": [
    "driftengine",
    "3d",
    "typescript",
    "photogrammetry",
    "depth-estimation",
    "gaussian-splatting",
    "reconstruction"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build.mjs @driftengine/capture"
  }
}
