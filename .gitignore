node_modules/
dist/
*.log
.DS_Store
*.local
models/
demo/dev/public/

# Capture output from scripts/shots.mjs. Diagnostic, regenerated on demand, never reviewed.
shots/

# Gradle's own build cache and Android build output. Machine-local, regenerated by every
# build, and it churned on every commit made from a machine that had ever built the host.
packages/package/android/.gradle/
packages/package/android/build/

# Agent scratch: holds git worktrees, which are whole checkouts of this repository.
# `scripts/docs.test.mjs` skips it for the same reason — walking one moves every file out
# of the path its exemptions are written against.
.claude/

# The suite's own summary, written by every `npm test` and read by `scripts/docs-counts.mjs` so
# the counts in CAPABILITIES.md cost nothing extra. Machine-local: it describes one run on one
# machine, and a committed copy would be a claim about somebody else's.
.vitest/
/.playwright-mcp/

# Reference sources fetched for a port, which are somebody else's and are not always MIT — the
# voxel sandbox reads Babylon-Lite's, which is Apache 2.0. Fetched on demand and never committed:
# an Apache-2.0 file inside an MIT tree is a licensing claim this repository cannot make.
.reference/

# The guard wordlist. Two tests refuse to let a consumer's proper nouns reach a file that ships,
# and a public repository that lists the nouns it forbids has published them. The lists live here
# instead; both guards no-op when the file is absent, which is the right answer for a contributor
# who has no private nouns to leak.
scripts/private-nouns.local.json
